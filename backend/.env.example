# Multi-Key Rotating & Auto-Failover Google AI Studio Cluster
GEMINI_API_KEY_1=AIzaSyYourFirstKeyHere
GEMINI_API_KEY_2=AIzaSyYourSecondKeyHere
GEMINI_API_KEY_3=AIzaSyYourThirdKeyHere
GEMINI_API_KEY_4=AIzaSyYourFourthKeyHere
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash
KEY_COOLDOWN_SECONDS=60

# Optional comma-separated or single fallback
# GEMINI_API_KEYS=key1,key2,key3,key4
# GEMINI_API_KEY=key1

# Database (leave blank for local SQLite, or paste Supabase PostgreSQL URL)
DATABASE_URL=sqlite+aiosqlite:///./forensic_local.db

# Server
PORT=8000
ENVIRONMENT=development
