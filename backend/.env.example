# Required for AI sketch compilation and image generation
GEMINI_API_KEY=your_gemini_api_key_here

# Leave blank to use instant local SQLite (fastest for development!)
# Or paste your Supabase connection string when ready
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Default settings
PORT=8000
ENVIRONMENT=development
